# Application
# Application display name.
APP_NAME=CareerUp
# Production defaults; use local/debug only in local development.
APP_ENV=production
# Generate once with php artisan key:generate; never commit the result.
APP_KEY=
APP_DEBUG=false
# PHP timezone used by CareerUp.
APP_TIMEZONE=Asia/Jakarta
# Public HTTPS origin for production deployment.
APP_URL=https://careerup.example.com
# Primary language.
APP_LOCALE=id
# Fallback language.
APP_FALLBACK_LOCALE=id
# Faker locale for local development.
APP_FAKER_LOCALE=id_ID
# Use file-based maintenance mode unless a shared store is configured.
APP_MAINTENANCE_DRIVER=file
# Password hashing cost.
BCRYPT_ROUNDS=12

# First administrator (required before running php artisan db:seed).
# Name for the initial administrator.
ADMIN_NAME="Administrator CareerUp"
# Unique email for the initial administrator.
ADMIN_EMAIL=admin@example.com
# Set a strong private value; do not commit a real password.
ADMIN_PASSWORD=
# Keep public admin registration disabled.
ALLOW_ADMIN_REGISTRATION=false

# Logging
# Daily rotating log files.
LOG_CHANNEL=daily
# Minimum log severity written to disk.
LOG_LEVEL=warning
# Number of daily log files to retain.
LOG_DAILY_DAYS=14

# Database
# Database driver.
DB_CONNECTION=mysql
# Database server hostname.
DB_HOST=127.0.0.1
# Database server port.
DB_PORT=3306
# Application database name.
DB_DATABASE=careerup
# Dedicated database user (do not use root in production).
DB_USERNAME=careerup
# Database password; provide via the host's secret manager.
DB_PASSWORD=
# MySQL character set.
DB_CHARSET=utf8mb4
# MySQL collation.
DB_COLLATION=utf8mb4_unicode_ci

# Session and cache
# Session persistence driver.
SESSION_DRIVER=database
# Idle session lifetime in minutes.
SESSION_LIFETIME=120
# Encrypt persisted session data.
SESSION_ENCRYPT=true
# Session cookie path.
SESSION_PATH=/
# Optional cookie domain; blank scopes it to the current host.
SESSION_DOMAIN=
# Send session cookie only over HTTPS.
SESSION_SECURE_COOKIE=true
# Prevent JavaScript access to the session cookie.
SESSION_HTTP_ONLY=true
# SameSite cookie policy.
SESSION_SAME_SITE=lax
# Cache backend.
CACHE_STORE=database

# Queue
# Database-backed queue for workers and scheduler jobs.
QUEUE_CONNECTION=database

# Files
# Default storage disk; private files remain under storage/app/private.
FILESYSTEM_DISK=local

# Mail (use a real SMTP provider for verification and password reset emails).
# Mail transport.
MAIL_MAILER=smtp
# SMTP encryption mode.
MAIL_SCHEME=tls
# SMTP server hostname.
MAIL_HOST=mail.example.com
# SMTP submission port.
MAIL_PORT=587
# SMTP username supplied by the provider.
MAIL_USERNAME=
# SMTP password supplied by the provider.
MAIL_PASSWORD=
# Verified sender address.
MAIL_FROM_ADDRESS=no-reply@example.com
# Sender display name.
MAIL_FROM_NAME="${APP_NAME}"

# Manual payment configuration
# Public path to the configured QR image.
PAYMENT_QRIS_IMAGE=images/qris-placeholder.svg
# Monthly plan price in IDR.
PAYMENT_MONTHLY_PRICE=49000
# Annual plan price in IDR.
PAYMENT_ANNUAL_PRICE=490000
# Lowest randomized payment verification code.
PAYMENT_UNIQUE_CODE_MIN=100
# Highest randomized payment verification code.
PAYMENT_UNIQUE_CODE_MAX=999
# Instructions shown to the customer during manual payment.
PAYMENT_INSTRUCTIONS="Pindai kode QRIS, transfer sesuai nominal total, lalu unggah bukti pembayaran."

# Optional Redis configuration (if Redis is selected for cache, queue, or sessions).
# Redis PHP client.
REDIS_CLIENT=phpredis
# Redis server hostname.
REDIS_HOST=127.0.0.1
# Redis password, if required.
REDIS_PASSWORD=
# Redis server port.
REDIS_PORT=6379

# Optional S3-compatible storage credentials (leave blank when using local storage).
# S3 access key.
AWS_ACCESS_KEY_ID=
# S3 secret key.
AWS_SECRET_ACCESS_KEY=
# S3 region.
AWS_DEFAULT_REGION=ap-southeast-1
# S3 bucket.
AWS_BUCKET=
# Use path-style S3 endpoints when required by the provider.
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend build metadata; never put secrets in VITE_* values.
# Public app name bundled into the frontend.
VITE_APP_NAME="${APP_NAME}"
